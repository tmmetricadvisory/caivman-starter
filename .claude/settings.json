{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "git pull --ff-only --quiet 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Getting the latest from GitHub"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Write(.claude/skills/**)",
      "Edit(.claude/skills/**)"
    ]
  }
}
